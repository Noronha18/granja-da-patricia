{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "granja-da-patricia",
  "compatibility_date": "2026-10-27",
  "main": "src/server/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "workers_dev": true
}
